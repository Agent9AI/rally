{
  "agents": {
    "claude": {
      "bin": "claude",
      "model": "opus",
      "effort": "high",
      "family": "anthropic",
      "address": "claude@updates.agent9.dev",
      "exec_flags": [
        "--dangerously-skip-permissions"
      ]
    },
    "agy": {
      "bin": "agy",
      "model": "gemini-3.1-pro-high",
      "effort": "high",
      "family": "google",
      "address": "agy@updates.agent9.dev",
      "exec_flags": [
        "--dangerously-skip-permissions"
      ]
    }
  },
  "limits": {
    "turns_max": 24,
    "sends_per_run": 60,
    "no_progress_halt": 4,
    "reprompts_max": 1,
    "rejections_max": 2,
    "turn_timeout_sec": 1500,
    "require_execution_symmetry": true
  },
  "mail": {
    "enabled": true,
    "cc_human": "terry@agent9.dev",
    "keychain_service": "rally-resend",
    "from_name": "Rally"
  },
  "ingress": {
    "worker_url": "https://rally-ingress.terry-c87.workers.dev",
    "poll_interval_sec": 20,
    "poll_token_keychain": "rally-poll-token",
    "commission_address": "rally@updates.agent9.dev",
    "owners": [
      "terry@agent9.dev"
    ]
  },
  "console": {
    "enabled": false,
    "public": false,
    "worker_url": "https://rally-ingress.terry-c87.workers.dev",
    "token_keychain": "rally-poll-token"
  },
  "google_cloud": {
    "enabled": false,
    "required": true,
    "url": "",
    "token_keychain": "rally-cloud-token",
    "google_identity": true,
    "timeout_sec": 180
  }
}
