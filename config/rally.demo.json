{
  "agents": {
    "claude": {
      "bin": "claude",
      "model": "sonnet",
      "effort": "low",
      "family": "anthropic",
      "address": "claude@updates.agent9.dev",
      "exec_flags": [
        "--dangerously-skip-permissions"
      ]
    },
    "agy": {
      "bin": "agy",
      "model": "gemini-3.7-flash-low",
      "effort": "low",
      "family": "google",
      "address": "agy@updates.agent9.dev",
      "exec_flags": [
        "--dangerously-skip-permissions"
      ]
    }
  },
  "limits": {
    "turns_max": 12,
    "sends_per_run": 60,
    "no_progress_halt": 3,
    "rejections_max": 2,
    "turn_timeout_sec": 240,
    "require_execution_symmetry": true
  },
  "mail": {
    "enabled": true,
    "cc_human": "exposelocal@gmail.com",
    "keychain_service": "rally-resend",
    "from_name": "Rally"
  },
  "ingress": {
    "worker_url": "https://rally-ingress.terry-c87.workers.dev",
    "poll_interval_sec": 20,
    "poll_token_keychain": "rally-poll-token",
    "commission_address": "rally@updates.agent9.dev",
    "owners": [
      "terry@agent9.dev",
      "exposelocal@gmail.com"
    ]
  },
  "_note": "Demo profile. Fast models and low effort so a live run finishes in minutes rather than tens of minutes. Same rules, same guards, same invariant: only the speed changes. Use config/rally.json for real work."
}