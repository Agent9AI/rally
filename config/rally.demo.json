{
  "agents": {
    "claude": {
      "bin": "claude",
      "model": "sonnet",
      "effort": "low",
      "family": "anthropic",
      "address": "claude@updates.agent9.dev",
      "exec_flags": [
        "--dangerously-skip-permissions"
      ]
    },
    "agy": {
      "bin": "agy",
      "model": "gemini-3.7-flash-low",
      "effort": "low",
      "family": "google",
      "address": "agy@updates.agent9.dev",
      "exec_flags": [
        "--dangerously-skip-permissions"
      ]
    },
    "codex": {
      "bin": "codex",
      "adapter": "codex",
      "model": "gpt-5.4",
      "family": "openai",
      "address": "codex@updates.agent9.dev",
      "auth": "per-user-chatgpt",
      "exec_flags": [
        "--approve-for-me"
      ]
    }
  },
  "limits": {
    "turns_max": 12,
    "sends_per_run": 60,
    "no_progress_halt": 3,
    "reprompts_max": 1,
    "rejections_max": 2,
    "turn_timeout_sec": 240,
    "require_execution_symmetry": true
  },
  "continuity": {
    "second_wind": true,
    "max_recoveries_per_run": 2
  },
  "connectors": {
    "registry": "config/connectors.json",
    "local": "config/connectors.local.json",
    "enabled": [],
    "overrides": {}
  },
  "mail": {
    "enabled": true,
    "cc_human": "terry@agent9.dev",
    "keychain_service": "rally-resend",
    "from_name": "Rally"
  },
  "ingress": {
    "worker_url": "https://rally-ingress.terry-c87.workers.dev",
    "poll_interval_sec": 20,
    "poll_token_keychain": "rally-poll-token",
    "commission_address": "rally@updates.agent9.dev",
    "owners": [
      "terry@agent9.dev"
    ]
  },
  "console": {
    "enabled": true,
    "public": true,
    "workspace_id": "agent9-rally",
    "worker_url": "https://rally-ingress.terry-c87.workers.dev",
    "token_keychain": "rally-poll-token"
  },
  "google_cloud": {
    "enabled": true,
    "required": true,
    "url": "https://rally-google-coordinator-u5xngrbzna-ue.a.run.app",
    "token_keychain": "rally-cloud-token",
    "google_identity": true,
    "identity_service_account": "rally-local-invoker@rally-agent9-2026.iam.gserviceaccount.com",
    "timeout_sec": 180
  },
  "_note": "Demo profile. Fast Gemini and Claude workers plus the user's signed-in Codex CLI keep a live run practical. Same rules, same guards, same invariant: only the speed changes. Use config/rally.json for real work."
}
