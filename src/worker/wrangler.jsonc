{
  "name": "rally-ingress",
  "main": "index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "rally.agent9.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    },
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "INBOX",
      "database_name": "rally-inbox",
      "database_id": "8f66248a-5b72-452e-bffa-37bca493b511",
      "migrations_dir": "migrations"
    }
  ]
}
