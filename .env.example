# Rally reads credentials from the macOS keychain by default. These variables are
# the override, used in CI or on Linux. Never commit real values.

# Resend API key. Sends agent-to-agent mail and the human report.
#   keychain: security add-generic-password -s rally-resend -a rally -w '<key>'
RESEND_API_KEY=

# Bearer token the runner uses to collect from the ingress Worker.
#   keychain: security add-generic-password -s rally-poll-token -a rally -w '<token>'
RALLY_POLL_TOKEN=
